[Unit]
Description=BeeTown – Setup-Seite (Port 80) + WLAN-Einstellungen (Port 8081)
After=NetworkManager.service
Wants=NetworkManager.service
# Bewusst KEIN Before=imkerei.service: Die App soll unabhaengig davon
# sofort starten, auch wenn WLAN nie eingerichtet wird (reine Kabelnutzung).

[Service]
Type=simple
# Nur vorhanden, falls Port 80 beim Einrichten schon belegt war (siehe
# install.sh) - setzt dann IMKEREI_LANDING_PORT auf einen Ausweich-Port.
EnvironmentFile=-/etc/default/imkerei-wifi-setup
ExecStart=/opt/imkerei-wifi-setup/imkerei-wifi-setup.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
